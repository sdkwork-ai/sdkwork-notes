# standalone.production
SDKWORK_NOTES_DEPLOYMENT_PROFILE=standalone
SDKWORK_NOTES_ENVIRONMENT=production
SDKWORK_NOTES_PROFILE_ID=standalone.production

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_NOTES_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_NOTES_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:8787
SDKWORK_NOTES_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8787

SDKWORK_NOTES_USE_MEMORY_DRIVE=0
SDKWORK_DRIVE_FACADE_URL=https://api.sdkwork.com

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=db.example.com
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_prod
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_prod
SDKWORK_DATABASE_USERNAME=sdkwork_ai_prod
SDKWORK_DATABASE_PASSWORD_FILE=/run/secrets/sdkwork/database-password
SDKWORK_DATABASE_SSL_MODE=require
SDKWORK_DATABASE_MAX_CONNECTIONS=32

VITE_SDKWORK_NOTES_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_NOTES_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8787
VITE_SDKWORK_APPBASE_APP_API_BASE_URL=http://127.0.0.1:3900


SDKWORK_CORS_ALLOWED_ORIGINS=https://notes.sdkwork.com,https://notes.birdcoder.com,https://notes.dtupay.com,https://notes.noaper.com,https://notes.sdkwork.cn,https://notes.birdcoder.cn,https://notes.dtupay.cn,https://notes.noaper.cn,https://notes.skubc.com,https://notes.skubc.cn,https://notes.zowalk.com,https://notes.zowalk.cn,https://notes.offer86.com,https://notes.offer86.cn,https://notes.86offer.com,https://notes.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
