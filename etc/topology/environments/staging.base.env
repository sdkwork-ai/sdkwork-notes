# SDKWork staging defaults (both deployment profiles)
# Staging has no Drive database/storage configuration, so page content uses the
# local in-memory Drive (MODULE_SPEC.md 4.2: memory is an explicit opt-in).
SDKWORK_NOTES_DRIVE_MODE=memory
SDKWORK_NOTES_ENVIRONMENT=staging
SDKWORK_CORS_ALLOWED_ORIGINS=https://notes-staging.sdkwork.com,http://notes-staging.sdkwork.com,https://notes-staging.birdcoder.com,http://notes-staging.birdcoder.com,https://notes-staging.dtupay.com,http://notes-staging.dtupay.com,https://notes-staging.noaper.com,http://notes-staging.noaper.com,https://notes-staging.sdkwork.cn,http://notes-staging.sdkwork.cn,https://notes-staging.birdcoder.cn,http://notes-staging.birdcoder.cn,https://notes-staging.dtupay.cn,http://notes-staging.dtupay.cn,https://notes-staging.noaper.cn,http://notes-staging.noaper.cn,https://notes-staging.skubc.com,http://notes-staging.skubc.com,https://notes-staging.skubc.cn,http://notes-staging.skubc.cn,https://notes-staging.zowalk.com,http://notes-staging.zowalk.com,https://notes-staging.zowalk.cn,http://notes-staging.zowalk.cn,https://notes-staging.offer86.com,http://notes-staging.offer86.com,https://notes-staging.offer86.cn,http://notes-staging.offer86.cn,https://notes-staging.86offer.com,http://notes-staging.86offer.com,https://notes-staging.86offer.cn,http://notes-staging.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,dsh-app://app,tauri://localhost,https://servicewechat.com
