# cloud.development
SDKWORK_NOTES_DEPLOYMENT_PROFILE=cloud
SDKWORK_NOTES_ENVIRONMENT=development
SDKWORK_NOTES_PROFILE_ID=cloud.development

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_NOTES_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_NOTES_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:8787
SDKWORK_NOTES_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
SDKWORK_NOTES_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=127.0.0.1
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
SDKWORK_DATABASE_USERNAME=sdkwork_ai_dev
SDKWORK_DATABASE_PASSWORD=sdkworkdev123
SDKWORK_DATABASE_SSL_MODE=disable
SDKWORK_DATABASE_MAX_CONNECTIONS=10

VITE_SDKWORK_NOTES_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_NOTES_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_NOTES_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_APPBASE_APP_API_BASE_URL=http://127.0.0.1:3900


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
SDKWORK_CORS_ALLOWED_ORIGINS=https://notes-dev.sdkwork.com,http://notes-dev.sdkwork.com,https://notes-dev.birdcoder.com,http://notes-dev.birdcoder.com,https://notes-dev.dtupay.com,http://notes-dev.dtupay.com,https://notes-dev.noaper.com,http://notes-dev.noaper.com,https://notes-dev.sdkwork.cn,http://notes-dev.sdkwork.cn,https://notes-dev.birdcoder.cn,http://notes-dev.birdcoder.cn,https://notes-dev.dtupay.cn,http://notes-dev.dtupay.cn,https://notes-dev.noaper.cn,http://notes-dev.noaper.cn,https://notes-dev.skubc.com,http://notes-dev.skubc.com,https://notes-dev.skubc.cn,http://notes-dev.skubc.cn,https://notes-dev.zowalk.com,http://notes-dev.zowalk.com,https://notes-dev.zowalk.cn,http://notes-dev.zowalk.cn,https://notes-dev.offer86.com,http://notes-dev.offer86.com,https://notes-dev.offer86.cn,http://notes-dev.offer86.cn,https://notes-dev.86offer.com,http://notes-dev.86offer.com,https://notes-dev.86offer.cn,http://notes-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
